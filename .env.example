# Copy to .env and fill in. Never commit .env.
# All keys are optional: they can also be typed in the app sidebar (kept only in that browser session).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Optional model overrides (defaults: gemini-3.8-flash, claude-opus-5, gpt-5.6-terra, deepseek-flash).
GEMINI_MODEL=
CLAUDE_MODEL=
OPENAI_MODEL=
DEEPSEEK_MODEL=
# Provider selected at start: gemini | claude | openai | deepseek | fake
# (falls back to fake when that provider has no key in this file)
LLM_PROVIDER=gemini
DATABASE_URL=sqlite:///data/granter.db
